@model IEnumerable<GestionTickets.Models.Tecnico>
@{
    ViewData["Title"] = "Técnicos";
}

<div class="encabezado">
    <div>
        <h1>Técnicos</h1>
        <p class="text-muted mb-0">Personal de soporte que atiende los tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" data-modal="Agregar técnico">
        <i class="bi bi-plus-lg me-1"></i>Agregar técnico
    </a>
</div>

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table tabla align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Correo)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                    <th>@Html.DisplayNameFor(m => m.Especialidad)</th>
                    <th>Estado</th>
                    <th class="text-end">Seguimientos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td>@item.Correo</td>
                        <td>@(item.Telefono ?? "—")</td>
                        <td>@item.Especialidad</td>
                        <td>
                            @if (item.Activo) { <span class="badge text-bg-success">Activo</span> }
                            else { <span class="badge text-bg-secondary">Inactivo</span> }
                        </td>
                        <td class="text-end">@item.Seguimientos.Count</td>
                        <td class="acciones">
                            <a asp-action="Details" asp-route-id="@item.TecnicoId" class="btn btn-sm btn-outline-secondary" data-modal="Detalle del técnico">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.TecnicoId" class="btn btn-sm btn-outline-primary" data-modal="Editar técnico">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.TecnicoId" class="btn btn-sm btn-outline-danger" data-modal="Eliminar técnico">Eliminar</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay técnicos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
