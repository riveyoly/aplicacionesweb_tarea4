@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="tarjeta p-4 text-center">
    <h1 class="h3 text-danger">Ocurrió un error</h1>
    <p class="text-muted">No se pudo completar la operación. Intente nuevamente en unos segundos.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código de la solicitud: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
