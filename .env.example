# Copie este archivo como .env y escriba una contraseña segura.
# .env NO se versiona ni se incluye en el .zip de entrega.

# Base de datos PostgreSQL (la crea el contenedor "db")
POSTGRES_DB=gestion_tickets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Conexión para ejecutar la app fuera de Docker (dotnet run) contra el contenedor db.
# Dentro de Docker, docker-compose usa DB_HOST=db y DB_PORT=5432 automáticamente.
DB_HOST=localhost
DB_PORT=5434

# Puerto del equipo donde se publica la aplicación web
WEB_PORT=8081
