@{
    var codigo = ViewData["Codigo"] as int? ?? 0;
    ViewData["Title"] = codigo == 404 ? "Página no encontrada" : "Error";
}

<div class="tarjeta p-5 text-center">
    <p class="display-5 fw-bold text-primary mb-1">@codigo</p>
    <h1 class="h4">@(codigo == 404 ? "La página o el registro no existe." : "No se pudo atender la solicitud.")</h1>
    <p class="text-muted">Revise la dirección o vuelva al inicio.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
