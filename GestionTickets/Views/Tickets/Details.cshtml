@model GestionTickets.Models.Ticket
@{
    ViewData["Title"] = $"Ticket #{Model.TicketId}";
    var historial = Model.Seguimientos.OrderByDescending(s => s.Fecha).ThenByDescending(s => s.SeguimientoId).ToList();
    var cerrado = Model.Estado == Catalogos.EstadoCerrado;
}

<div class="encabezado">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Volver a tickets</a>
        <h1>Ticket #@Model.TicketId</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.TicketId" class="btn btn-outline-primary" data-modal="Editar ticket">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.TicketId" class="btn btn-outline-danger" data-modal="Eliminar ticket">Eliminar</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="tarjeta p-4 h-100">
            <h2 class="h4">@Model.Asunto</h2>
            <p class="text-muted" style="white-space: pre-line">@Model.Descripcion</p>
            <dl class="row detalle mb-0">
                <dt class="col-sm-4">Usuario</dt>
                <dd class="col-sm-8">@Model.Usuario.Texto · @Model.Usuario.Departamento</dd>
                <dt class="col-sm-4">Categoría</dt>
                <dd class="col-sm-8">
                    @Model.Categoria.Nombre
                    <span class="badge @Catalogos.ClasePrioridad(Model.Categoria.Prioridad)">@Model.Categoria.Prioridad</span>
                </dd>
                <dt class="col-sm-4">Fecha de apertura</dt>
                <dd class="col-sm-8">@Model.FechaApertura.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="tarjeta p-4 h-100">
            <dl class="row detalle mb-0">
                <dt class="col-6">Estado</dt>
                <dd class="col-6"><span class="badge @Catalogos.ClaseEstado(Model.Estado)">@Model.Estado</span></dd>
                <dt class="col-6">Técnico asignado</dt>
                <dd class="col-6">@Model.TecnicoAsignado</dd>
                <dt class="col-6">Fecha límite</dt>
                <dd class="col-6">
                    @Model.FechaLimite.ToString("dd/MM/yyyy HH:mm")
                    @if (Model.Vencido) { <span class="badge text-bg-danger">Vencido</span> }
                </dd>
                <dt class="col-6">Seguimientos</dt>
                <dd class="col-6">@Model.Seguimientos.Count</dd>
            </dl>
        </div>
    </div>
</div>

<div class="tarjeta p-4 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Historial de seguimientos</h2>
        @if (!cerrado)
        {
            <a asp-controller="Seguimientos" asp-action="Create" asp-route-ticketId="@Model.TicketId" asp-route-volver="ticket"
               class="btn btn-primary btn-sm" data-modal="Agregar seguimiento">
                <i class="bi bi-plus-lg me-1"></i>Agregar seguimiento
            </a>
        }
        else
        {
            <span class="text-muted small">Ticket cerrado: no admite más seguimientos.</span>
        }
    </div>
    @if (historial.Count == 0)
    {
        <p class="text-muted mb-0">Sin seguimientos: el ticket está abierto y sin técnico asignado.</p>
    }
    else
    {
        <ul class="linea-tiempo">
            @foreach (var s in historial)
            {
                <li>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <strong>@s.Fecha.ToString("dd/MM/yyyy")</strong>
                        <span class="badge @Catalogos.ClaseEstado(s.Estado)">@s.Estado</span>
                        <span class="text-muted small">por @s.Tecnico.Nombre</span>
                    </div>
                    <div>@s.Comentario</div>
                </li>
            }
        </ul>
    }
</div>
