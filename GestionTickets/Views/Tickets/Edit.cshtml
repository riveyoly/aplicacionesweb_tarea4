@model GestionTickets.Models.Ticket
@{
    ViewData["Title"] = "Editar ticket";
}

<h1 class="titulo-pagina solo-pagina">Editar ticket #@Model.TicketId</h1>
<div class="tarjeta p-4">
    <form asp-action="Edit">
        <input type="hidden" asp-for="TicketId" />
        <partial name="_Formulario" model="Model" />
    </form>
</div>
