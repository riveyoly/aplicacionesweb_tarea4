@model IEnumerable<GestionTickets.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="encabezado">
    <div>
        <h1>Usuarios</h1>
        <p class="text-muted mb-0">Personas de la empresa que reportan tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" data-modal="Agregar usuario">
        <i class="bi bi-plus-lg me-1"></i>Agregar usuario
    </a>
</div>

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table tabla align-middle mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Cedula)</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Correo)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                    <th>@Html.DisplayNameFor(m => m.Departamento)</th>
                    <th class="text-end">Tickets</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Cedula</td>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td>@item.Correo</td>
                        <td>@(item.Telefono ?? "—")</td>
                        <td>@item.Departamento</td>
                        <td class="text-end">@item.Tickets.Count</td>
                        <td class="acciones">
                            <a asp-action="Details" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-outline-secondary" data-modal="Detalle del usuario">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-outline-primary" data-modal="Editar usuario">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.UsuarioId" class="btn btn-sm btn-outline-danger" data-modal="Eliminar usuario">Eliminar</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay usuarios registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
